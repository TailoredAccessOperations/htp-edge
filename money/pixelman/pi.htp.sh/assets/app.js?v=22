"use strict";

const $ = (id) => document.getElementById(id);
const now = () => Math.floor(Date.now() / 1000);

// Literal colours, not CSS variables: var() does not resolve inside SVG
// presentation attributes (stroke="var(--x)") in every browser.
const INK = {
  blue: "#2563eb",
  green: "#16a34a",
  amber: "#ea580c",
  red: "#e11d48",
  rule: "#e9ebef"
};

function fmtDur(seconds) {
  if (!Number.isFinite(seconds)) return "—";
  const d = Math.floor(seconds / 86400);
  const h = Math.floor((seconds % 86400) / 3600);
  const m = Math.floor((seconds % 3600) / 60);
  if (d) return d + "d " + h + "h";
  if (h) return h + "h " + m + "m";
  return m + "m";
}

function fmtAgo(ts) {
  if (!ts) return "—";
  const s = Math.max(0, now() - Number(ts));
  if (s < 5) return "just now";
  if (s < 60) return s + "s ago";
  if (s < 3600) return Math.floor(s / 60) + "m ago";
  if (s < 86400) return Math.floor(s / 3600) + "h " + Math.floor((s % 3600) / 60) + "m ago";
  return Math.floor(s / 86400) + "d " + Math.floor((s % 86400) / 3600) + "h ago";
}

function fmtNum(value) {
  return value === null || value === undefined ? "—" : Number(value).toLocaleString("en-US");
}

function fmtRate(kbs) {
  if (!Number.isFinite(kbs)) return "—";
  if (kbs < 1) return "0 KB/s";
  if (kbs < 1024) return kbs.toFixed(kbs < 10 ? 1 : 0) + " KB/s";
  return (kbs / 1024).toFixed(1) + " MB/s";
}

function fmtSize(mb) {
  if (!Number.isFinite(mb)) return "—";
  if (mb < 1024) return mb + " MB";
  return (mb / 1024).toFixed(1) + " GB";
}

function fmtDate(iso) {
  const parts = String(iso).split("-");
  if (parts.length !== 3) return iso;
  const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  return months[Number(parts[1]) - 1] + " " + Number(parts[2]);
}

/* ------------------------------------------------------------- freshness */

function setFresh(el, ts, prefix) {
  el.dataset.ts = ts;
  el.dataset.prefix = prefix || "updated";
  el.textContent = el.dataset.prefix + " " + fmtAgo(ts);
}

function tickFresh() {
  document.querySelectorAll(".fresh[data-ts]").forEach((el) => {
    el.textContent = (el.dataset.prefix || "updated") + " " + fmtAgo(el.dataset.ts);
  });
}

/* ------------------------------------------------------------- sparkline */

function spark(el, series, opts) {
  const W = 300, H = 64, PAD = 4;
  const all = series.flatMap((s) => s.values).filter(Number.isFinite);
  const baseline = (H - PAD).toFixed(1);
  const rule = '<line x1="' + PAD + '" y1="' + baseline + '" x2="' + (W - PAD) +
    '" y2="' + baseline + '" stroke="' + INK.rule + '" stroke-width="1"/>';
  if (all.length < 2) { el.innerHTML = rule; return; }

  const lo = opts && Number.isFinite(opts.min) ? opts.min : Math.min(...all);
  let hi = opts && Number.isFinite(opts.max) ? opts.max : Math.max(...all);
  if (!(hi > lo)) hi = lo + 1;

  let markup = rule;
  for (const s of series) {
    const points = [];
    s.values.forEach((v, i) => {
      if (!Number.isFinite(v)) return;
      const x = PAD + i * (W - 2 * PAD) / Math.max(s.values.length - 1, 1);
      const y = H - PAD - ((v - lo) / (hi - lo)) * (H - 2 * PAD);
      points.push([x, y]);
    });
    if (points.length < 2) continue;
    const line = points.map((p, i) => (i ? "L" : "M") + p[0].toFixed(1) + " " + p[1].toFixed(1)).join(" ");
    const last = points[points.length - 1][0].toFixed(1);
    const first = points[0][0].toFixed(1);
    markup += '<path d="' + line + " L" + last + " " + baseline + " L" + first + " " + baseline +
      ' Z" fill="' + s.fill + '"/>';
    markup += '<path d="' + line + '" fill="none" stroke="' + s.stroke +
      '" stroke-width="1.75" vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round"/>';
  }
  el.innerHTML = markup;
}

/* ------------------------------------------------------------- render */

/* ------------------------------------------------------- on the page now */

function renderConcurrent(s) {
  const block = s.concurrent || {};
  // the reader is on the page by definition, and the collector's window lags
  // their first poll by a tick, so never show them a zero
  const live = Math.max(Number(block.now) || 0, 1);
  const peak = Math.max(Number(block.peak) || 0, 0);
  const record = "highest so far, <b>" + fmtNum(peak) + "</b> at once";
  $("here-now").textContent = fmtNum(live);
  $("here-peak").innerHTML = record;
  $("views-now").textContent = fmtNum(live);
  $("views-peak").innerHTML = record;
}

function renderStats(s) {
  $("uptime").textContent = fmtDur(s.uptime_s);
  renderConcurrent(s);
  $("booted").textContent = "booted " + fmtAgo(s.boot_ts);

  $("cpu").textContent = s.cpu.pct + "%";
  $("cores").textContent = s.cpu.cores + " cores";

  $("mem").textContent = s.mem.used_mb + " MB";
  $("mem-free").textContent = "of " + s.mem.total_mb + " MB";

  $("temp").textContent = (s.cpu.temp_c === null ? "—" : s.cpu.temp_c + "°C");
  $("throttle-sub").textContent = s.throttled.now
    ? "throttling right now"
    : (s.throttled.ever ? "throttled previously" : "no throttling");

  $("cpu-now").textContent = s.cpu.pct + "%";
  $("net-now").textContent = "↓ " + fmtRate(s.net.rx_kbps) + "  ↑ " + fmtRate(s.net.tx_kbps);

  $("mem-bar-label").textContent = s.mem.pct + "% used";
  $("mem-sub").textContent = s.mem.avail_mb + " MB free of " + s.mem.total_mb + " MB";
  $("mem-bar").style.width = Math.min(100, s.mem.pct) + "%";
  $("mem-bar").style.background = s.mem.pct > 85 ? INK.amber : INK.blue;

  $("disk-bar-label").textContent = s.disk.used_pct + "% used";
  $("disk-bar").style.width = Math.min(100, s.disk.used_pct) + "%";
  $("disk-sub").textContent = s.disk.free_gb + " GB free of " + s.disk.total_gb + " GB";

  $("load").textContent = s.cpu.load.map((n) => n.toFixed(2)).join(" / ");

  const iface = (s.net && s.net.iface) || "";
  const wireless = iface.indexOf("wl") === 0;
  $("wifi").textContent = s.wifi ? s.wifi.quality_pct + "%" : (wireless ? "—" : "n/a");
  const specNet = $("spec-net");
  if (specNet && iface) {
    specNet.textContent = wireless
      ? "WiFi, 802.11ac"
      : (iface.indexOf("eth") === 0 ? "Ethernet, gigabit" : iface);
  }
  $("net-total").textContent = "↓ " + fmtSize(s.net.rx_total_mb) + "  ↑ " + fmtSize(s.net.tx_total_mb);
  $("swap-used").textContent = s.mem.swap_total_mb
    ? s.mem.swap_used_mb + " / " + s.mem.swap_total_mb + " MB"
    : "none";
  if (s.procs) {
    $("procs").textContent = fmtNum(s.procs.total);
    $("procs").title = fmtNum(s.procs.running) + " running";
  }

  const history = s.history || {};
  const cpuHistory = history.cpu || [];
  const cpuPeak = cpuHistory.length ? Math.max(...cpuHistory) : 0;
  spark($("spark-cpu"), [{ values: cpuHistory, stroke: INK.blue, fill: "rgba(37,99,235,.12)" }],
    { min: 0, max: Math.max(5, cpuPeak * 1.25) });
  spark($("spark-net"), [
    { values: history.rx || [], stroke: INK.blue, fill: "rgba(37,99,235,.10)" },
    { values: history.tx || [], stroke: INK.green, fill: "rgba(22,163,74,.10)" }
  ]);

  renderServices(s.services || []);
  setFresh($("fresh-status"), s.ts);

  const failing = (s.services || []).filter((x) => x.state !== "active").length;
  const issues = failing + (s.throttled.now ? 1 : 0);
  $("status-pill").querySelector(".dot").className = "dot " + (issues ? "bad" : "ok");
  $("status-text").textContent = issues
    ? issues + " issue" + (issues > 1 ? "s" : "")
    : "all systems operational";
}

// Inline reference to a sprite symbol. Decorative: the label text carries
// the meaning, so these stay out of the accessibility tree.
function icon(id) {
  return '<svg class="ic" aria-hidden="true" focusable="false"><use href="#i-' +
    id + '"></use></svg>';
}

// Service name -> sprite symbol. Unknown names fall back to a neutral dot.
const SERVICE_ICONS = {
  "cloudflare tunnel": "cloud",
  "ssh": "terminal",
  "tailscale": "network",
  "cron": "clock",
  "caddy": "server",
  "collector": "activity",
  "speedtest timer": "gauge"
};

function serviceIcon(name) {
  return SERVICE_ICONS[String(name).toLowerCase()] || "dot";
}

function renderServices(list) {
  const el = $("services");
  if (!list.length) { el.innerHTML = '<li class="service muted">no data</li>'; return; }
  const t = now();
  el.innerHTML = list.map((s) => {
    const ok = s.state === "active";
    let when = "";
    if (s.next) {
      when = "next in " + fmtDur(Math.max(0, s.next - t));
    } else if (s.since) {
      const up = t - s.since;
      when = up > 30 ? "up " + fmtDur(up) : (ok ? "starting" : "stopped");
    } else {
      when = ok ? "running" : "stopped";
    }
    return '<li class="service">' + icon(serviceIcon(s.name)) +
      '<span class="name">' + s.name + '</span>' +
      '<span class="when"><span class="dot ' + (ok ? "ok" : "bad") + '"></span>' +
        when + "</span></li>";
  }).join("");
}

function isoOf(date) {
  return date.getFullYear() + "-" + String(date.getMonth() + 1).padStart(2, "0") +
    "-" + String(date.getDate()).padStart(2, "0");
}

// First day of a fixed-length window ending on `todayIso`.
function windowStart(todayIso, days) {
  const parts = String(todayIso || "").split("-").map(Number);
  if (parts.length !== 3 || !parts[0]) return todayIso;
  const cursor = new Date(parts[0], parts[1] - 1, parts[2]);
  cursor.setDate(cursor.getDate() - (days - 1));
  return isoOf(cursor);
}

// The most recent `limit` days between two dates. Walks backwards, so a long
// span still yields the newest window.
function rangeKeys(fromIso, toIso, limit) {
  const from = String(fromIso || toIso || "").split("-").map(Number);
  const to = String(toIso || fromIso || "").split("-").map(Number);
  if (from.length !== 3 || to.length !== 3 || !from[0] || !to[0]) return [];
  const start = new Date(from[0], from[1] - 1, from[2]);
  const cursor = new Date(to[0], to[1] - 1, to[2]);
  const keys = [];
  while (cursor >= start && keys.length < limit) {
    keys.push(isoOf(cursor));
    cursor.setDate(cursor.getDate() - 1);
  }
  return keys.reverse();
}

function drawBars(container, keys, valueOf, titleOf, maxValue, minVisible, colorOf, hasData) {
  container.innerHTML = "";
  container.style.maxWidth = "none";
  const gap = 4;
  const available = container.clientWidth || 300;
  // Bars take their slot width, but never more than the chart's height, so a
  // short window stays squarish instead of turning into wide blocks.
  const barMax = Math.max(16, Math.round(container.clientHeight || 64));
  const barWidth = Math.min(barMax, Math.max(14,
    Math.floor((available - (keys.length - 1) * gap) / Math.max(1, keys.length))));
  const total = keys.length * barWidth + (keys.length - 1) * gap;
  container.style.maxWidth = total + "px";
  keys.forEach((key) => {
    const present = hasData ? hasData(key) : true;
    const value = valueOf(key);
    const wrapper = document.createElement("div");
    wrapper.className = present ? "day" : "day empty";
    wrapper.title = titleOf(key, value);
    const bar = document.createElement("i");
    bar.style.height = present
      ? Math.max((value / maxValue) * 100, value ? minVisible : 0).toFixed(1) + "%"
      : "0%";
    if (colorOf && present) bar.style.background = colorOf(value);
    wrapper.appendChild(bar);
    container.appendChild(wrapper);
  });
  return total;
}

function renderDays(data) {
  const days = data.days || {};
  const dataKeys = Object.keys(days).sort();
  if (!dataKeys.length) return;
  const today = data.today || dataKeys[dataKeys.length - 1];
  const keys = rangeKeys(windowStart(today, 14), today, 14);
  const overall = Math.min(100, Number(data.pct) || 0);
  $("avail-pct").textContent = overall.toFixed(1).replace(/\.0$/, "") + "%";
  if (data.first) $("avail-since").textContent = "since " + fmtDate(data.first);
  const width = drawBars($("days"), keys,
    (key) => {
      const entry = days[key];
      if (!entry) return 0;
      return Math.min(100, ((entry.samples || 0) / Math.max(1, entry.expected || 1)) * 100);
    },
    (key, value) => (days[key]
      ? fmtDate(key) + ": " + value.toFixed(1) + "% (" + fmtNum(days[key].samples || 0) + " samples)"
      : fmtDate(key) + ": no data"),
    100, 4,
    (value) => (value >= 99 ? INK.green : value >= 95 ? INK.amber : INK.red),
    (key) => Boolean(days[key]));
  $("days-axis").style.maxWidth = Math.max(width, 56) + "px";
  $("days-first").textContent = fmtDate(keys[0]);
  $("days-last").textContent = keys.length > 1
    ? (keys[keys.length - 1] === today ? "today" : fmtDate(keys[keys.length - 1]))
    : "";
  setFresh($("fresh-avail"), data.ts);
}

function renderSpeed(data) {
  const r = data.last;
  const el = $("speed");
  if (!r) { el.innerHTML = '<span class="muted">no result yet</span>'; return; }
  if (!r.ok) { el.innerHTML = '<span class="muted">last test failed</span>'; return; }

  el.innerHTML =
    '<div class="speed-item"><b>' + r.down_mbps + '</b><small>' +
      icon("down") + 'Mbps down</small></div>' +
    '<div class="speed-item"><b>' + r.up_mbps + '</b><small>' +
      icon("up") + 'Mbps up</small></div>' +
    '<div class="speed-item"><b>' + r.ping_ms + '</b><small>' +
      icon("timer") + 'ms latency</small></div>' +
    '<div class="speed-meta">via ' + r.server + '</div>';

  const results = Array.isArray(data.results) ? data.results : [];
  const newest = results.length ? results[results.length - 1] : null;
  if (newest && newest.ok === false) {
    el.innerHTML += '<div class="speed-warn">the latest run failed</div>';
  }
  setFresh($("fresh-speed"), r.ts, "tested");
}

function renderResponse(data) {
  const response = data.response || {};
  const basis = response.page || response.all;
  if (!basis) return;
  $("resp-median").textContent = basis.median_ms;
  $("resp-detail").textContent = "p95 " + basis.p95_ms + " ms · " +
    fmtNum(basis.samples) + (response.page ? " page loads" : " requests");
}

function renderHits(data) {
  $("hits-total").textContent = fmtNum(data.views_total);
  $("here-views").textContent = fmtNum(data.views_total) + " page views";
  $("hits-today").textContent = fmtNum(data.views_today);
  if (data.today) $("hits-date").textContent = fmtDate(data.today);

  const days = data.days || {};
  const dataKeys = Object.keys(days).sort();
  if (!dataKeys.length) return;
  const today = data.today || dataKeys[dataKeys.length - 1];
  const keys = rangeKeys(windowStart(today, 14), today, 14);
  const max = Math.max(1, ...keys.map((k) => (days[k] && days[k].views) || 0));
  const width = drawBars($("hits-days"), keys,
    (key) => (days[key] && days[key].views) || 0,
    (key, value) => (days[key]
      ? fmtDate(key) + ": " + fmtNum(value) + " views"
      : fmtDate(key) + ": no views"),
    max, 4, null,
    (key) => Boolean(days[key]));
  $("hits-axis").style.maxWidth = Math.max(width, 56) + "px";
  $("hits-first").textContent = fmtDate(keys[0]);
  $("hits-last").textContent = keys.length > 1
    ? (keys[keys.length - 1] === today ? "today" : fmtDate(keys[keys.length - 1]))
    : "";

  renderResponse(data);
  setFresh($("fresh-hits"), data.ts);
}

/* ------------------------------------------------------------- lightbox */

function initLightbox() {
  const dialog = $("lightbox");
  if (!dialog || typeof dialog.showModal !== "function") return;
  const image = $("lightbox-img");
  const caption = $("lightbox-caption");

  document.querySelectorAll(".shot").forEach((button) => {
    button.addEventListener("click", () => {
      image.src = button.dataset.full;
      image.alt = button.dataset.caption || "";
      caption.textContent = button.dataset.caption || "";
      dialog.showModal();
    });
  });

  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog.addEventListener("close", () => { image.src = ""; });
  const closeButton = document.querySelector(".lightbox-close");
  if (closeButton) closeButton.addEventListener("click", () => dialog.close());
}

/* ------------------------------------------------------------- data */

async function getJSON(path) {
  const res = await fetch(path, { cache: "no-store" });
  if (!res.ok) throw new Error(path + " " + res.status);
  return res.json();
}

async function loadStats() {
  try {
    renderStats(await getJSON("/stats.json"));
  } catch (err) {
    $("status-pill").querySelector(".dot").className = "dot bad";
    $("status-text").textContent = "stats unavailable";
  }
}

async function loadUptime() {
  try { renderDays(await getJSON("/uptime.json")); } catch (err) { /* keep old */ }
}

async function loadSpeed() {
  try { renderSpeed(await getJSON("/speedtest.json")); } catch (err) { /* keep old */ }
}

async function loadHits() {
  try { renderHits(await getJSON("/hits.json")); } catch (err) { /* keep old */ }
}

initLightbox();
loadStats();
loadUptime();
loadSpeed();
loadHits();
setInterval(loadStats, 10000);
setInterval(loadUptime, 60000);
setInterval(loadSpeed, 60000);
setInterval(loadHits, 60000);
setInterval(tickFresh, 1000);
