<!doctype html><html lang="en"><head><meta charset="utf-8"><meta content="width=device-width,initial-scale=1" name="viewport"><title>Apple Maps — Reference</title><link href="/htp-critical.css" rel="stylesheet"><link href="/osint/osint.css" rel="stylesheet"><link href="/osint/vendor/leaflet/leaflet.css" rel="stylesheet"><style>
body { margin: 0; padding: 0; overflow: hidden; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
#map { height: 100vh; width: 100vw; z-index: 1; }
.apple-overlay {
  position: absolute; top: 20px; left: 20px; z-index: 1000;
  width: 320px; background: rgba(255,255,255,0.85); backdrop-filter: blur(10px);
  border-radius: 18px; padding: 1.5rem; box-shadow: 0 8px 32px rgba(0,0,0,0.1);
  color: #000; transition: transform 0.3s ease;
}
.apple-overlay h1 { font-size: 1.2rem; margin: 0 0 0.5rem; font-weight: 600; }
.apple-overlay p { font-size: 0.9rem; color: #666; margin: 0 0 1rem; line-height: 1.4; }
.apple-btn {
  display: block; width: 100%; padding: 10px; background: #007AFF; color: #fff;
  text-align: center; text-decoration: none; border-radius: 10px;
  font-weight: 500; font-size: 0.9rem; margin-bottom: 0.5rem;
}
.apple-btn-sec { background: #E5E5EA; color: #000; }
</style></head><body>
<div class="apple-overlay" id="overlay">
  <h1 id="title">Loading...</h1>
  <p id="address">Connecting to GPS satellites...</p>
  <a href="https://maps.apple.com" class="apple-btn">Directions</a>
  <a href="/osint" class="apple-btn apple-btn-sec">Back to OSINT</a>
</div>
<div id="map"></div>
<script src="/osint/vendor/leaflet/leaflet.js"></script>
<script>
  fetch('/maps/gps-ref.json').then(r => r.json()).then(d => {
    document.getElementById('title').textContent = d.target;
    document.getElementById('address').textContent = d.address;
    
    const map = L.map('map', { zoomControl: false }).setView([d.coordinates.lat, d.coordinates.lon], 16);
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
      attribution: 'Tiles &copy; Esri'
    }).addTo(map);
    
    L.marker([d.coordinates.lat, d.coordinates.lon]).addTo(map)
      .bindPopup(d.target).openPopup();
  });
</script></body></html>
